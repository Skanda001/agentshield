# ─── App ───────────────────────────────────────────────
APP_ENV=development                     # development | production
APP_NAME=AgentShield
LOG_LEVEL=INFO

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://agentshield:agentshield@localhost:5432/agentshield

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth ──────────────────────────────────────────────
# 32+ chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENTSHIELD_JWT_SECRET=replace-with-at-least-32-random-characters-please
AGENTSHIELD_JWT_ALGORITHM=HS256
AGENTSHIELD_ACCESS_TOKEN_MINUTES=30

# ─── API ───────────────────────────────────────────────
API_DOCS_ENABLED=true                   # set false in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Policy ────────────────────────────────────────────
POLICY_DIR=./policies

# ─── Audit ─────────────────────────────────────────────
AUDIT_HMAC_SECRET=replace-with-a-different-32-char-random-secret