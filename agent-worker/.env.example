# AgentShield gateway URL (required)
AGENTSHIELD_URL=https://agentshield-qhxo.onrender.com

# Agent API key — leave blank to auto-provision on first run.
# After first run, copy the printed key here to persist across restarts.
AGENTSHIELD_API_KEY=

# Optional: real PostgreSQL DB so tools query real data
# If blank, falls back to 3-customer SQLite mock
DATABASE_URL=

# Delay range between agent runs (seconds)
MIN_DELAY_SECS=45
MAX_DELAY_SECS=90
