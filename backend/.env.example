# AgentShield Backend Environment Configuration Example
# Copy to .env and configure before starting the gateway

# Application Environment
APP_ENV=development
APP_NAME=AgentShield
LOG_LEVEL=INFO
DEMO_MODE=false

# Database & Cache
DATABASE_URL=postgresql+psycopg://agentshield:agentshield@localhost:5432/agentshield
REDIS_URL=redis://localhost:6379/0

# Authentication & Cryptographic Keys (Must be at least 32 characters each; all three must differ)
AGENTSHIELD_JWT_SECRET=replace-with-at-least-32-random-characters-jwt
AGENTSHIELD_JWT_ALGORITHM=HS256
AGENTSHIELD_ACCESS_TOKEN_MINUTES=30
AUDIT_HMAC_SECRET=replace-with-a-different-32-char-random-secret-audit
API_KEY_HMAC_SECRET=replace-with-a-third-32-char-random-secret-apikey

# API & Documentation
API_DOCS_ENABLED=true
ALLOW_PUBLIC_DOCS=false

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_REGEX=

# Policies
POLICY_DIR=./policies

# Emergency Controls & HITL Integrations
KILL_SWITCH_ENABLED=true
SLACK_WEBHOOK_URL=
APPROVAL_BASE_URL=http://localhost:8000
APPROVAL_TIMEOUT_MINUTES=30

# Supabase Telemetry & Audit Mirroring
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=agentshield_call_logs

# Groq Explanation Engine (Optional)
GROQ_API_KEY=
